# ─── Core ────────────────────────────────────────────────────────────────
# Public URL of this app. Tracking pixels, click links and unsubscribe links point here,
# so in production it must be reachable from the internet (e.g. https://mail.yood.ai).
APP_URL=http://localhost:3000

# Time zone for dates shown in the dashboard (campaigns each have their own sending time zone)
APP_TIMEZONE=Asia/Dubai

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yoodco

# 32+ random characters each. Generate with:  openssl rand -base64 48
SESSION_SECRET=change-me-session-secret-at-least-32-characters
# Encrypts mailbox passwords and OAuth tokens at rest. Changing it disconnects every mailbox.
ENCRYPTION_KEY=change-me-encryption-key-at-least-32-characters

# First admin account, created by `npm run db:seed`
ADMIN_EMAIL=admin@yood.ai
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Admin

# ─── Test mode ───────────────────────────────────────────────────────────
# Where TEST-mode campaigns deliver. Mailpit (in docker-compose) catches everything
# and shows it at http://localhost:8025. Leave empty to keep test emails only in the app.
SANDBOX_SMTP_URL=smtp://localhost:1025
SANDBOX_WEB_URL=http://localhost:8025

# ─── Google (Gmail / Google Workspace) ───────────────────────────────────
# OAuth client from Google Cloud Console. Redirect URI: {APP_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: service account JSON (one line) with domain-wide delegation for scope https://mail.google.com/
# Lets an admin connect every @yood.ai mailbox without each person signing in.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ─── Microsoft 365 / Outlook ─────────────────────────────────────────────
# App registration in Entra ID. Redirect URI: {APP_URL}/api/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ─── Serverless hosting (Vercel) ────────────────────────────────────────
# Where a long-running worker is not possible, a scheduler calls /api/cron/tick every minute
# with the header  Authorization: Bearer <CRON_SECRET>. See docs/DEPLOY_VERCEL.md.
CRON_SECRET=

# ─── Worker tuning (defaults are fine) ───────────────────────────────────
WORKER_TICK_SECONDS=10
INBOX_SCAN_MINUTES=3
# A mailbox is paused automatically when its bounce rate over the last 50 sends exceeds this
AUTO_PAUSE_BOUNCE_RATE=0.05

# ─── Replies and meetings ────────────────────────────────────────────────
# Secret part of the booking webhook address /api/meetings/<key> (Calendly, Cal.com, Zapier).
# Leave empty to derive one from the database password.
MEETING_WEBHOOK_KEY=
# Optional: have replies read by AI instead of the built-in rules.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# Company name in meeting titles when it can't be taken from the mailbox domain.
COMPANY_NAME=
