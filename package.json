{
  "name": "yoodco-email",
  "version": "1.0.0",
  "description": "Paced outbound email sequences from your own mailboxes, with open, click and reply tracking.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "demo": "tsx scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "vercel-build": "prisma generate && node scripts/db-setup.mjs && next build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waliworkshere/yoodco-email.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/waliworkshere/yoodco-email/issues"
  },
  "homepage": "https://github.com/waliworkshere/yoodco-email#readme",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "exceljs": "^4.4.0",
    "imapflow": "^2.10.0",
    "jose": "^6.0.11",
    "mailparser": "^3.14.1",
    "next": "^16.4.3",
    "nodemailer": "^10.3.1",
    "papaparse": "^5.5.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.15.32",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "prisma": "^6.19.3",
    "smtp-server": "^3.21.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
